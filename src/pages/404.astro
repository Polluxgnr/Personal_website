---
import Base from '../layouts/Base.astro';
import { useTranslations } from '../i18n/ui.ts';

const t = useTranslations('en');
---

<Base lang="en" path="/404/" title={t('notfound.title')}>
  <section class="wrap section">
    <h1>{t('notfound.title')}</h1>
    <p>{t('notfound.body')}</p>
    <p class="actions">
      <a class="button" href="/">
        {t('notfound.home')}
      </a>
      <a class="text-link" href="/contact/">
        {t('nav.contact')}
      </a>
    </p>
  </section>
</Base>

<style>
  h1 {
    font-size: var(--step-head);
    margin-bottom: 0.875rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }
  p + p {
    margin-top: 1.5rem;
  }
</style>
