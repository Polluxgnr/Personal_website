---
import Base from '../layouts/Base.astro';
import Flow from './Flow.astro';
import Timeline from './Timeline.astro';
import { Picture } from 'astro:assets';
import portrait from '../assets/path-portrait.jpg';
import { profile } from '../lib/data.ts';
import { associations, educationItems, experienceItems, work } from '../lib/timeline.ts';
import { pick, useTranslations, type Lang } from '../i18n/ui.ts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const sections = [
  { id: 'experience', title: t('about.work'), items: experienceItems(work, lang) },
  { id: 'associations', title: t('about.assoc'), items: experienceItems(associations, lang) },
  { id: 'education', title: t('about.edu'), items: educationItems(lang) },
];
const toc = [
  { id: 'path', title: t('bg.path') },
  ...sections,
  { id: 'skills', title: t('about.skills') },
];
---

<Base lang={lang} path="/about/" title={t('bg.title')} description={t('bg.description')}>
  <div class="wrap page">
    <h1 data-words>{t('bg.title')}</h1>
    <div class="intro" data-reveal-group>
      {profile.intro.map((p) => (
        <p data-reveal>{pick(p, lang)}</p>
      ))}
    </div>

    <nav class="toc" aria-label={t('bg.title')}>
      <ul>
        {toc.map((s) => (
          <li>
            <a href={`#${s.id}`}>{s.title}</a>
          </li>
        ))}
      </ul>
    </nav>

    <section id="path" aria-labelledby="path-title">
      <h2 id="path-title" data-words>
        {t('bg.path')}
      </h2>
      <div class="path">
        <Flow
          label={t('bg.path')}
          steps={profile.journey.map((j) => ({
            title: pick(j.title, lang),
            detail: pick(j.text, lang),
            tag: j.when,
          }))}
        />
        <figure class="portrait" data-reveal>
          <Picture
            src={portrait}
            alt={lang === 'fr' ? 'Pollux Gronier en costume' : 'Pollux Gronier in a suit jacket'}
            widths={[360, 640, 960]}
            sizes="(min-width: 64rem) 30vw, 90vw"
            formats={['avif', 'webp']}
            loading="lazy"
          />
        </figure>
      </div>
    </section>

    {sections.map((s) => (
      <section id={s.id} aria-labelledby={`${s.id}-title`}>
        <h2 id={`${s.id}-title`} data-words>
          {s.title}
        </h2>
        <Timeline lang={lang} items={s.items} />
      </section>
    ))}

    <section id="skills" aria-labelledby="skills-title">
      <h2 id="skills-title" data-words>
        {t('about.skills')}
      </h2>
      <div class="cards" data-reveal-group>
        {profile.skills.map((g) => (
          <div class="card" data-reveal>
            <h3>{pick(g.group, lang)}</h3>
            <ul class="tags">
              {g.items.map((i) => (
                <li>{i}</li>
              ))}
            </ul>
          </div>
        ))}
        <div class="card" data-reveal>
          <h3>{t('about.languages')}</h3>
          <ul class="plain">
            {profile.languages.map((l) => (
              <li>
                {pick(l.name, lang)}, {pick(l.level, lang)}
              </li>
            ))}
          </ul>
        </div>
        <div class="card" data-reveal>
          <h3>{t('about.interests')}</h3>
          <ul class="plain">
            {profile.interests.map((i) => (
              <li>{pick(i, lang)}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  h1 {
    font-size: var(--step-display);
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  .intro {
    max-width: 44ch;
    font-size: var(--step-lead);
    line-height: 1.45;
  }
  .intro p + p {
    margin-top: 1rem;
  }
  .toc {
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .toc ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
  }
  .toc a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.4em 1.1em;
    border-radius: 999px;
    background: var(--surface);
    font-size: var(--step-small);
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 160ms var(--ease),
      color 160ms var(--ease);
  }
  .toc a:hover {
    background: var(--ink);
    color: var(--bg);
  }
  section {
    padding-top: var(--section-gap);
  }
  .path {
    display: grid;
    gap: 2rem;
    align-items: start;
  }
  .portrait {
    order: -1;
    margin: 0;
    overflow: hidden;
    border-radius: 1.5rem;
  }
  .portrait :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (min-width: 64rem) {
    .path {
      grid-template-columns: minmax(0, 6fr) minmax(0, 4fr);
      gap: clamp(2rem, 5vw, 5rem);
    }
    .portrait {
      order: 0;
      position: sticky;
      top: 7rem;
    }
  }
  h2 {
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  .cards {
    display: grid;
    gap: 0.5rem;
  }
  @media (min-width: 48rem) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 80rem) {
    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .card {
    padding: clamp(1.25rem, 2.4vw, 2rem);
    border-radius: 1.25rem;
    background: var(--surface);
  }
  .card h3 {
    margin-bottom: 1rem;
  }
  .card .tags li {
    background: var(--surface-2);
  }
  .plain {
    padding-left: 1.1em;
  }
</style>
