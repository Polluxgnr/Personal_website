---
/**
 * An ordered flow: a vertical rail that fills as you scroll, and steps that
 * light up when the rail reaches them. Used for how a project works and for
 * my path. The order is real, so the steps are numbered.
 */
interface Step {
  title: string;
  detail: string;
  /** Small text next to the title, such as a year. */
  tag?: string;
}

interface Props {
  steps: readonly Step[];
  label: string;
}

const { steps, label } = Astro.props;
---

<ol class="flow" aria-label={label} data-flow>
  <span class="rail" aria-hidden="true">
    <span class="fill" data-flow-fill></span>
  </span>
  {steps.map((step, i) => (
    <li data-flow-step>
      <span class="node" aria-hidden="true">
        {i + 1}
      </span>
      <div class="body">
        <h3>
          {step.title}
          {step.tag && <span class="tag">{step.tag}</span>}
        </h3>
        <p>{step.detail}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .flow {
    position: relative;
    list-style: none;
    padding: 0;
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  .rail {
    position: absolute;
    left: 1.2rem;
    top: 1.2rem;
    bottom: 1.2rem;
    width: 2px;
    background: var(--surface-2);
    border-radius: 2px;
  }
  .fill {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--accent);
    transform-origin: top;
  }
  li {
    position: relative;
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
  }
  .node {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: var(--surface-2);
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.875rem;
    transition:
      background-color 400ms var(--ease),
      color 400ms var(--ease),
      transform 400ms var(--ease-out);
  }
  li[data-lit] .node {
    background: var(--accent);
    color: var(--accent-ink);
    transform: scale(1.08);
  }
  h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.9rem;
    margin-bottom: 0.4rem;
    font-size: var(--step-lead);
  }
  .tag {
    color: var(--muted);
    font-family: var(--font-text);
    font-size: var(--step-small);
    font-weight: 600;
    letter-spacing: 0;
  }
  p {
    max-width: 62ch;
    color: var(--muted);
    transition: color 400ms var(--ease);
  }
  li[data-lit] p {
    color: var(--ink);
  }
  /* Without script every step reads in full colour. */
  :global(html:not(.motion-ready)) li .node {
    background: var(--accent);
    color: var(--accent-ink);
  }
  :global(html:not(.motion-ready)) li p {
    color: var(--ink);
  }
</style>
