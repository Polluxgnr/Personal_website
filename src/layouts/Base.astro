---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import portrait from '../assets/profile.jpg';
// Preloading the two main fonts avoids a reflow (layout shift) when they swap in.
import displayFont from '@fontsource-variable/unbounded/files/unbounded-latin-wght-normal.woff2?url';
import textFont from '@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2?url';
import { statsCode } from '../config.ts';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../lib/data.ts';
import { localizePath, otherLang, pick, useTranslations, type Lang } from '../i18n/ui.ts';

interface Props {
  lang: Lang;
  /** English path of this page, e.g. "/" or "/projects/cinegraph/". */
  path: string;
  title?: string;
  description?: string;
}

const { lang, path, title, description } = Astro.props;
const t = useTranslations(lang);
const pageTitle = title ? `${title} | Pollux Gronier` : t('meta.title');
const pageDescription = description ?? t('meta.description');
const canonical = new URL(localizePath(path, lang), Astro.site);
const alternate = new URL(localizePath(path, otherLang(lang)), Astro.site);
const english = new URL(localizePath(path, 'en'), Astro.site);

const og = await getImage({ src: portrait, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site);
// The share image shown when a link to this page is posted (rendered at build time by scripts/build-og.ts).
const shareImage = new URL(`/og-${lang}.png`, Astro.site);
const shareAlt = pick(profile.role, lang) + ', ' + profile.name;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: profile.links.site,
  jobTitle: pick(profile.role, lang),
  image: ogUrl.href,
  sameAs: [profile.links.github, profile.links.linkedin],
  alumniOf: profile.education.slice(0, 1).map((e) => ({
    '@type': 'CollegeOrUniversity',
    name: e.school,
  })),
  knowsLanguage: ['fr', 'en', 'zh'],
  address: { '@type': 'PostalAddress', addressLocality: profile.location, addressCountry: 'FR' },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={otherLang(lang)} href={alternate} />
    <link rel="alternate" hreflang="x-default" href={english} />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={textFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0a0a0b" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={shareAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={shareAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    {/* Before first paint: apply the saved tint, and hide the parts the motion layer reveals
        (they come back by themselves if the motion module never starts). */}
    <script is:inline>
      try {
        const tint = localStorage.getItem('tint');
        if (tint === 'paper' || tint === 'abyss' || tint === 'night') {
          document.documentElement.dataset.theme = tint;
        }
      } catch {
        // Storage is unavailable (private mode): keep the default tint.
      }
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion-ready');
        setTimeout(function () {
          if (!window.__motion) document.documentElement.classList.remove('motion-ready');
        }, 3000);
      }
    </script>
  </head>
  <body data-stats={statsCode || undefined}>
    <canvas class="bg" data-bg aria-hidden="true"></canvas>
    <div class="progress" data-progress aria-hidden="true"></div>
    <a class="skip" href="#main">
      {t('nav.skip')}
    </a>
    <Header lang={lang} path={path} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import '../scripts/analytics.ts';
      import '../scripts/background.ts';
      import '../scripts/motion.ts';
    </script>
  </body>
</html>

<style>
  /* The interactive background sits behind everything and never takes a click. */
  .bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  /* Reading progress: a thin accent bar that fills as the page scrolls. */
  .progress {
    position: fixed;
    inset: 0 0 auto;
    height: 4px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    z-index: 30;
  }
  .skip {
    position: absolute;
    left: var(--margin);
    top: -10rem;
    z-index: 40;
    padding: 0.6rem 1rem;
    background: var(--ink);
    color: var(--bg);
  }
  .skip:focus {
    top: 0.75rem;
  }
  main:focus {
    outline: none;
  }
</style>
