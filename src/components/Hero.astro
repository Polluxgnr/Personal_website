---
import { Picture } from 'astro:assets';
import portrait from '../assets/profile.jpg';
import { profile } from '../lib/data.ts';
import { localizePath, pick, useTranslations, type Lang } from '../i18n/ui.ts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero wrap" aria-labelledby="hero-title" data-hero>
  <div class="text">
    <p class="role" data-hero-fade>
      {pick(profile.role, lang)}, CentraleSupélec × ESSEC
    </p>
    <h1 id="hero-title">
      <span class="line">
        <span>Pollux</span>
      </span>
      <span class="line">
        <span>Gronier</span>
      </span>
    </h1>
    <p class="headline" data-hero-fade>
      {pick(profile.headline, lang)}
    </p>
    <div class="actions" data-hero-fade>
      <a class="button" href={localizePath('/contact/', lang)} data-magnetic>
        {t('hero.contact')}
      </a>
      <a class="text-link" href={`/cv/pollux-gronier-cv-${lang}.pdf`} download>
        {t('hero.cv')}
      </a>
    </div>
    <p class="now" data-hero-fade>
      <span class="dot" aria-hidden="true"></span>
      <span>
        <strong>{t('hero.now')}</strong> {pick(profile.now, lang)}
      </span>
    </p>
  </div>

  <figure class="photo" data-hero-photo>
    <Picture
      src={portrait}
      alt={t('hero.photo')}
      widths={[400, 640, 960]}
      sizes="(min-width: 64rem) 34vw, 90vw"
      formats={['avif', 'webp']}
      loading="eager"
      fetchpriority="high"
    />
  </figure>
</section>

<style>
  .hero {
    display: grid;
    gap: 2rem var(--margin);
    align-items: center;
    padding-block: clamp(1.5rem, 4vw, 4rem) 0;
  }
  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      min-height: calc(100svh - 4.75rem);
      padding-bottom: 2rem;
    }
  }
  .role {
    color: var(--muted);
    font-weight: 600;
    margin-bottom: 1.25rem;
  }
  h1 {
    font-size: var(--step-display);
    line-height: 0.95;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  .line {
    display: block;
    overflow: hidden;
    padding-block: 0.04em;
  }
  .line > span {
    display: block;
  }
  .headline {
    font-size: var(--step-lead);
    line-height: 1.4;
    max-width: 30ch;
    margin-bottom: 2rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-bottom: 2.5rem;
  }
  .now {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    max-width: 46ch;
    color: var(--muted);
    font-size: var(--step-small);
  }
  .now strong {
    color: var(--ink);
  }
  .dot {
    flex: none;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse 2.4s var(--ease) infinite;
  }
  @keyframes pulse {
    50% {
      transform: scale(1.6);
      opacity: 0.4;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dot {
      animation: none;
    }
  }

  .photo {
    margin: 0;
    overflow: hidden;
    border-radius: 1.5rem;
    justify-self: end;
    width: 100%;
    max-width: 30rem;
  }
  .photo :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 45% 40%;
    will-change: transform;
  }

  :global(html.motion-ready) .line > span {
    transform: translateY(110%);
  }
  :global(html.motion-ready) [data-hero-fade] {
    opacity: 0;
  }
  :global(html.motion-ready) [data-hero-photo] {
    clip-path: inset(100% 0 0 0 round 1.5rem);
  }

  @media (max-width: 63.99rem) {
    h1 {
      font-size: clamp(2.75rem, 14vw, 6.5rem);
    }
    /* On phones the photo sits right under the name, cropped wider. */
    .text {
      display: contents;
    }
    .role {
      order: 1;
      margin: 0;
    }
    h1 {
      order: 2;
      margin: 0;
    }
    .photo {
      order: 3;
      justify-self: start;
      max-width: none;
    }
    .photo :global(img) {
      aspect-ratio: 4 / 3;
      object-position: 45% 30%;
    }
    .headline {
      order: 4;
      margin: 0;
    }
    .actions {
      order: 5;
      margin: 0;
    }
    .now {
      order: 6;
    }
    .hero {
      gap: 1.25rem;
    }
  }
</style>
