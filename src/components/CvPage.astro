---
/**
 * The CV page: the CV itself as a picture of the PDF, with the download right above it.
 * The English one is my own hand-made CV; the French one is printed from the site data.
 * Both pictures are made at build time (see scripts/build-cv-pdf.ts).
 */
import Base from '../layouts/Base.astro';
import { localizePath, useTranslations, type Lang } from '../i18n/ui.ts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const fr = lang === 'fr';
---

<Base
  lang={lang}
  path="/cv/"
  title="CV"
  description={
    fr
      ? 'Le CV de Pollux Gronier, étudiant en IA et data science à CentraleSupélec et à l’ESSEC.'
      : 'The CV of Pollux Gronier, AI and data science student at CentraleSupélec and ESSEC.'
  }
>
  <section class="wrap page" aria-labelledby="cv-title">
    <div class="layout">
      <div class="top">
        <div>
          <h1 id="cv-title" data-words>
            CV
          </h1>
          <p class="lede">
            {fr
              ? 'Une page. Pour me joindre, passez par le formulaire : mon téléphone et mon e-mail ne sont volontairement pas dessus.'
              : 'One page. To reach me, use the form: my phone and email are deliberately not on it.'}
          </p>
        </div>
        <div class="actions">
          <a class="button" href={`/cv/pollux-gronier-cv-${lang}.pdf`} download data-magnetic>
            {t('cv.download')}
          </a>
          <a class="text-link" href={localizePath('/contact/', lang)}>
            {t('hero.contact')}
          </a>
        </div>
      </div>

      <figure class="sheet" data-reveal>
        <img
          src={`/cv/pollux-gronier-cv-${lang}.jpg`}
          width="1240"
          height="1754"
          alt={
            fr
              ? 'Mon CV d’une page : formation à CentraleSupélec et à l’ESSEC, stages chez Digimobee et Enedis, associations, langues et compétences.'
              : 'My one-page CV: studies at CentraleSupélec and ESSEC, internships at Digimobee and Enedis, associations, languages and skills.'
          }
          decoding="async"
        />
      </figure>
    </div>
  </section>
</Base>

<style>
  h1 {
    font-size: var(--step-display);
  }
  .layout h1 {
    margin-bottom: 0;
  }
  .layout {
    display: grid;
    gap: 2rem clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  @media (min-width: 64rem) {
    .layout {
      grid-template-columns: minmax(0, 4fr) minmax(0, 6fr);
    }
    .top {
      position: sticky;
      top: 7rem;
    }
  }
  .top {
    display: grid;
    gap: 1.75rem;
  }
  .lede {
    max-width: 44ch;
    margin-top: 1rem;
    color: var(--muted);
    font-size: var(--step-lead);
    line-height: 1.4;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }
  .sheet {
    margin: 0;
    overflow: hidden;
    border-radius: 1rem;
    background: #fff;
  }
  .sheet img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
